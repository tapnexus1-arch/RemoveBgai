# RemoveBG AI - Environment Configuration

# Frontend Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
VITE_APP_URL="http://localhost:3000"

# Google AdSense Monetization (Configure with your real publisher ID)
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-8048092069219386"
VITE_ADSENSE_CLIENT_ID="ca-pub-8048092069219386"

# AdSense Slot IDs (Optional per position)
VITE_ADSENSE_SLOT_HEADER_BANNER=""
VITE_ADSENSE_SLOT_BELOW_HERO=""
VITE_ADSENSE_SLOT_BETWEEN_SECTIONS=""
VITE_ADSENSE_SLOT_SIDEBAR=""
VITE_ADSENSE_SLOT_BELOW_EDITOR=""
VITE_ADSENSE_SLOT_BEFORE_FOOTER=""

# Backend API Configuration
BACKEND_URL="http://localhost:8000"
VITE_BACKEND_URL="http://localhost:8000"
VITE_PREFER_BACKEND="false"

# Resource & Rate Limits
MAX_FILE_SIZE="26214400"
MAX_IMAGE_PIXELS="16000000"
MAX_CONCURRENT_JOBS="4"
RATE_LIMIT_PER_MINUTE="60"

# Privacy & Automatic Cleanup (Seconds before temporary files are purged)
IMAGE_RETENTION_SECONDS="300"
TEMP_DIR="/tmp/removebg_ai"

# AI Model & Acceleration Settings
MODEL_NAME="briaai/RMBG-1.4"
MODEL_PATH=""
DEVICE="cpu"  # Set to "cuda" for NVIDIA GPU server

# Admin Security Key
ADMIN_SECRET="admin123"
